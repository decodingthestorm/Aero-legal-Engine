# Distributed Celery worker container.
FROM python:3.11-slim AS base

WORKDIR /app

COPY pyproject.toml README.md ./
COPY src ./src

# workers extra: celery/redis. Add ",postgres" too if a task ever needs the
# SQL statute repository directly rather than going through the API.
RUN pip install --no-cache-dir ".[workers]"

CMD ["celery", "-A", "legal_engine.workers.celery_app", "worker", "--loglevel=info"]
