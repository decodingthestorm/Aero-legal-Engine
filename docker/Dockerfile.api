# Production FastAPI gateway container.
# Note: api/main.py is not implemented yet (Phase 4) — this Dockerfile builds
# and installs the package now so the image is ready the moment it lands.
FROM python:3.11-slim AS base

WORKDIR /app

COPY pyproject.toml README.md ./
COPY src ./src

RUN pip install --no-cache-dir .

EXPOSE 8000

CMD ["uvicorn", "legal_engine.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
