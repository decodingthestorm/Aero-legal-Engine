# Production FastAPI gateway container.
FROM python:3.11-slim AS base

WORKDIR /app

COPY pyproject.toml README.md ./
COPY src ./src

# api extra: fastapi/uvicorn, the gateway itself.
# postgres extra: only needed if deployed with LEGAL_ENGINE_STATUTE_BACKEND=sql
# (default is in-memory, in which case these two packages are simply unused).
RUN pip install --no-cache-dir ".[api,postgres]"

EXPOSE 8000

CMD ["uvicorn", "legal_engine.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
